# ==============================================================================
# Natural Language Video Search System - Configuration Environment Template
# Copy this file to .env and adjust variables as necessary for your environment.
# ==============================================================================

# Application Settings
APP_NAME="Natural Language Video Search System"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT="development"

# Database Configuration (SQLite default)
DATABASE_URL="sqlite:///./app.db"

# Storage Directories
UPLOAD_FOLDER="videos"
FRAMES_FOLDER="frames"
CLIPS_FOLDER="clips"
PROCESSING_FOLDER="processing"
FAISS_INDEX_FOLDER="faiss_indexes"
EMBEDDINGS_FOLDER="embeddings"
LOG_FOLDER="logs"

# AI / ML Model Configurations
CLIP_MODEL_NAME="openai/clip-vit-base-patch32"
YOLO_MODEL_PATH="yolov8n.pt"

# Search & Similarity Thresholds
SIMILARITY_THRESHOLD=0.20
CLIP_MIN_SCORE=0.25
CLIP_SCORE_MARGIN=0.03

# Video Pipeline & Event Tracking Settings
FRAME_EXTRACTION_INTERVAL=0.5
CLIP_PADDING_SECONDS=1.5
EVENT_MIN_CONSECUTIVE=2
EVENT_GAP_TOLERANCE=2.0
EVENT_MAX_LENGTH=30.0
YOLO_CONFIDENCE=0.5

# Upload & File Restrictions
MAX_UPLOAD_SIZE=524288000
ALLOWED_MIME_TYPES="video/mp4,video/x-m4v,video/quicktime"

# Logging Settings
LOG_LEVEL="INFO"
